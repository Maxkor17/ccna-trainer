rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Кожен користувач бачить і змінює лише власні дані: users/{uid}/...
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Щоб дозволити вхід лише собі, замініть рядок вище на:
      // allow read, write: if request.auth != null && request.auth.uid == uid
      //                    && request.auth.token.email == "ваш@gmail.com";
    }
  }
}
